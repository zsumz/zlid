#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$ROOT/target}"
export CARGO_INCREMENTAL="${CARGO_INCREMENTAL:-0}"

"$ROOT/scripts/check-architecture"
"$ROOT/scripts/check-metadata"
cargo fmt --manifest-path "$ROOT/Cargo.toml" --all -- --check
cargo clippy --manifest-path "$ROOT/Cargo.toml" --locked --all-targets --all-features -- -D warnings
cargo test --manifest-path "$ROOT/Cargo.toml" --locked --all-targets --all-features
cargo test --manifest-path "$ROOT/Cargo.toml" --locked --doc --all-features
RUSTDOCFLAGS="${RUSTDOCFLAGS:-} -D warnings" \
  cargo doc --manifest-path "$ROOT/Cargo.toml" --locked --no-deps --all-features
"$ROOT/scripts/check-package" --allow-dirty

echo "All checks passed"
